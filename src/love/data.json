 12.1, "lines": [{"speaker": "凛", "text": "根据计算……你对我心率的影响，超出了误差范围。", "start": 5.66, "end": 9.47}, {"speaker": "凛", "text": "……不许笑。", "start": 11.1, "end": 12.09}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "R_I": {"title": "轻音部·只为你的一首歌", "mood": "", "image_url": "/static/love/R_I.webp", "video_url": "/static/love/R_I.mp4", "last_url": "/static/love/R_I_last.webp", "dur": 12.1, "lines": [{"speaker": "莓", "text": "下一首歌——是写给台下某个笨蛋的！", "start": 4.68, "end": 7.57}, {"speaker": "莓", "text": "不许告诉别人哦。", "start": 9.98, "end": 11.33}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "R_Y": {"title": "雨夜·樱花树下的她", "mood": "", "image_url": "/static/love/R_Y.webp", "video_url": "/static/love/R_Y.mp4", "last_url": "/static/love/R_Y_last.webp", "dur": 12.1, "lines": [{"speaker": "雪", "text": "你终于……又来了。", "start": 3.92, "end": 6.23}, {"speaker": "悠真", "text": "我们……以前见过吗？", "start": 7.16, "end": 9.13}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_S1": {"title": "传说成真", "mood": "", "image_url": "/static/love/E_S1.webp", "video_url": "/static/love/E_S1.mp4", "last_url": "/static/love/E_S1_last.webp", "dur": 10.1, "lines": [{"speaker": "诗音", "text": "我喜欢你。从入学那天被你撞到开始……一直都是。", "start": 2.92, "end": 6.99}, {"speaker": "悠真", "text": "我也是。", "start": 7.68, "end": 8.49}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_S2": {"title": "优等生的眼泪", "mood": "", "image_url": "/static/love/E_S2.webp", "video_url": "/static/love/E_S2.mp4", "last_url": "/static/love/E_S2_last.webp", "dur": 10.1, "lines": [{"speaker": "诗音", "text": "伦敦的大学……我还是决定去了。", "start": 0.44, "end": 3.71}, {"speaker": "诗音", "text": "等我回来，树下见。", "start": 6.5, "end": 8.47}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_S3": {"title": "全校广播的告白", "mood": "", "image_url": "/static/love/E_S3.webp", "video_url": "/static/love/E_S3.mp4", "last_url": "/static/love/E_S3_last.webp", "dur": 10.1, "lines": [{"speaker": "诗音", "text": "春日同学，我……我喜欢你！", "start": 2.04, "end": 5.27}, {"speaker": "悠真", "text": "我听到了——全校都听到了。", "start": 7.24, "end": 10.1}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_S4": {"title": "大小姐的三年计划", "mood": "", "image_url": "/static/love/E_S4.webp", "video_url": "/static/love/E_S4.mp4", "last_url": "/static/love/E_S4_last.webp", "dur": 10.1, "lines": [{"speaker": "诗音", "text": "入学那天的相撞……是我计划好的。", "start": 2.6, "end": 5.91}, {"speaker": "诗音", "text": "十年前你答应过娶我——想赖账吗？", "start": 6.54, "end": 10.1}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_H1": {"title": "终点线的告白", "mood": "", "image_url": "/static/love/E_H1.webp", "video_url": "/static/love/E_H1.mp4", "last_url": "/static/love/E_H1_last.webp", "dur": 10.1, "lines": [{"speaker": "阳菜", "text": "悠真！我喜欢你！从小就喜欢！", "start": 4.18, "end": 5.6}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_H2": {"title": "永远的青梅竹马", "mood": "", "image_url": "/static/love/E_H2.webp", "video_url": "/static/love/E_H2.mp4", "last_url": "/static/love/E_H2_last.webp", "dur": 10.08, "lines": [{"speaker": "阳菜", "text": "我们……就一直这样，好不好？", "start": 0.0, "end": 3.43}, {"speaker": "悠真", "text": "嗯。一直这样。", "start": 5.92, "end": 7.27}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_H3": {"title": "错过的夏天", "mood": "", "image_url": "/static/love/E_H3.webp", "video_url": "/static/love/E_H3.mp4", "last_url": "/static/love/E_H3_last.webp", "dur": 10.1, "lines": [{"speaker": "阳菜", "text": "悠真……你一直都没有说。", "start": 5.14, "end": 7.33}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_H4": {"title": "传说之树·修罗场", "mood": "", "image_url": "/static/love/E_H4.webp", "video_url": "/static/love/E_H4.mp4", "last_url": "/static/love/E_H4_last.webp", "dur": 10.1, "lines": [{"speaker": "阳菜", "text": "悠真！你到底——约了几个人？！", "start": 6.44, "end": 8.91}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_R1": {"title": "心跳方程式", "mood": "", "image_url": "/static/love/E_R1.webp", "video_url": "/static/love/E_R1.mp4", "last_url": "/static/love/E_R1_last.webp", "dur": 10.1, "lines": [{"speaker": "凛", "text": "结论只有一个——我，喜欢你。", "start": 3.03, "end": 6.08}, {"speaker": "悠真", "text": "这道题，我也算出来了。", "start": 5.88, "end": 8.21}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_R2": {"title": "十年后的来信", "mood": "", "image_url": "/static/love/E_R2.webp", "video_url": "/static/love/E_R2.mp4", "last_url": "/static/love/E_R2_last.webp", "dur": 10.1, "lines": [{"speaker": "凛", "text": "我去十年后看一眼——看你有没有娶我。", "start": 0.76, "end": 4.19}, {"speaker": "凛", "text": "答案是——会的。", "start": 7.32, "end": 9.67}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_R3": {"title": "恋爱药水事故", "mood": "", "image_url": "/static/love/E_R3.webp", "video_url": "/static/love/E_R3.mp4", "last_url": "/static/love/E_R3_last.webp", "dur": 10.1, "lines": [{"speaker": "凛", "text": "春日……你今天好帅哦……", "start": 4.52, "end": 9.29}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_R4": {"title": "实验对象", "mood": "", "image_url": "/static/love/E_R4.webp", "video_url": "/static/love/E_R4.mp4", "last_url": "/static/love/E_R4_last.webp", "dur": 10.1, "lines": [{"speaker": "凛", "text": "三年的观察记录。你是我唯一的实验对象。", "start": 1.56, "end": 5.29}, {"speaker": "凛", "text": "结论——我选你，不选诺贝尔奖。", "start": 5.92, "end": 9.95}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_I1": {"title": "万人面前的告白", "mood": "", "image_url": "/static/love/E_I1.webp", "video_url": "/static/love/E_I1.mp4", "last_url": "/static/love/E_I1_last.webp", "dur": 10.1, "lines": [{"speaker": "莓", "text": "全世界听好了——我喜欢的人，就在那里！", "start": 2.74, "end": 6.49}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_I2": {"title": "出道的代价", "mood": "", "image_url": "/static/love/E_I2.webp", "video_url": "/static/love/E_I2.mp4", "last_url": "/static/love/E_I2_last.webp", "dur": 10.1, "lines": [{"speaker": "莓", "text": "这首歌……送给那个再也见不到的人。", "start": 4.36, "end": 7.99}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_I3": {"title": "两个人的乐队", "mood": "", "image_url": "/static/love/E_I3.webp", "video_url": "/static/love/E_I3.mp4", "last_url": "/static/love/E_I3_last.webp", "dur": 10.1, "lines": [{"speaker": "莓", "text": "组合名我想好了——就叫“笨蛋和我”！", "start": 2.96, "end": 5.45}, {"speaker": "悠真", "text": "那我是哪个？", "start": 6.06, "end": 7.47}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_I4": {"title": "偶像的素颜", "mood": "", "image_url": "/static/love/E_I4.webp", "video_url": "/static/love/E_I4.mp4", "last_url": "/static/love/E_I4_last.webp", "dur": 10.1, "lines": [{"speaker": "莓", "text": "这样的我……你还会喜欢吗？", "start": 6.9, "end": 8.7}, {"speaker": "悠真", "text": "我喜欢的，一直是这样的你。", "start": 8.7, "end": 10.1}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_Y1": {"title": "千年之约", "mood": "", "image_url": "/static/love/E_Y1.webp", "video_url": "/static/love/E_Y1.mp4", "last_url": "/static/love/E_Y1_last.webp", "dur": 10.1, "lines": [{"speaker": "雪", "text": "我是这棵树等了一千年的约定。", "start": 0.0, "end": 2.85}, {"speaker": "悠真", "text": "那这一次——换我来守约。", "start": 3.02, "end": 5.89}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_Y2": {"title": "樱花散落", "mood": "", "image_url": "/static/love/E_Y2.webp", "video_url": "/static/love/E_Y2.mp4", "last_url": "/static/love/E_Y2_last.webp", "dur": 10.1, "lines": [{"speaker": "雪", "text": "谢谢你……记得我。", "start": 2.1, "end": 6.03}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_Y3": {"title": "第一千次入学式", "mood": "", "image_url": "/static/love/E_Y3.webp", "video_url": "/static/love/E_Y3.mp4", "last_url": "/static/love/E_Y3_last.webp", "dur": 10.1, "lines": [{"speaker": "雪", "text": "这是第一千次了。这一次，你会选我吗？", "start": 3.26, "end": 7.63}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_Y4": {"title": "雪的真身", "mood": "", "image_url": "/static/love/E_Y4.webp", "video_url": "/static/love/E_Y4.mp4", "last_url": "/static/love/E_Y4_last.webp", "dur": 10.1, "lines": [{"speaker": "雪", "text": "我在梦里……一直在树下等你。", "start": 3.03, "end": 6.36}, {"speaker": "悠真", "text": "我来了。", "start": 9.1, "end": 9.9}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}, "E_Y5": {"title": "心动回廊·真结局", "mood": "", "image_url": "/static/love/E_Y5.webp", "video_url": "/static/love/E_Y5.mp4", "last_url": "/static/love/E_Y5_last.webp", "dur": 10.1, "lines": [{"speaker": "雪", "text": "传说不是只能选一个人——而是让所有人都幸福。", "start": 0.0, "end": 4.47}, {"speaker": "诗音", "text": "所以——三年后，我们还在这里见！", "start": 5.06, "end": 8.41}], "film": true, "ambience": null, "sfx": null, "sfx_at": 0}}, "cast": {"诗音": {"color": "#a78bfa", "img": "/static/love/cast/shion.webp", "side": "L", "brand": "完美的学生会长，高岭之花，其实藏着十年的秘密"}, "阳菜": {"color": "#fb923c", "img": "/static/love/cast/hina.webp", "side": "L", "brand": "田径部王牌，从小一起长大的青梅竹马"}, "凛": {"color": "#67e8f9", "img": "/static/love/cast/rin.webp", "side": "L", "brand": "科学部天才少女，嘴上理性，心跳不讲道理"}, "莓": {"color": "#f472b6", "img": "/static/love/cast/ichigo.webp", "side": "L", "brand": "轻音部主唱，校园偶像，舞台上最闪耀的那颗星"}, "雪": {"color": "#e2e8f0", "img": "/static/love/cast/yuki.webp", "side": "L", "brand": "樱花树下的神秘转学生，好像认识你很久了"}, "悠真": {"color": "#fbbf24", "img": "/static/love/cast/yuma.webp", "side": "R", "brand": "你。普通的高中二年级生，春日悠真"}}}