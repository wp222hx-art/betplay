{
  "scenes": {
    "S1": {
      "title": "雨夜天台",
      "lines": [
        {
          "speaker": "旁白",
          "text": "38层天台，城市像湿漉漉的星",
          "mood": "冷清"
        },
        {
          "speaker": "林夏",
          "text": "这是最后一次交易，为了小雨",
          "mood": "冷静"
        },
        {
          "speaker": "陈默",
          "text": "我来拿证，也来还你一条命",
          "mood": "隐忍"
        },
        {
          "speaker": "渡鸦",
          "text": "夜色适合埋葬秘密",
          "mood": "冷笑"
        },
        {
          "speaker": "林小雨(电话)",
          "text": "姐，外面很危险",
          "mood": "担心"
        },
        {
          "speaker": "旁白",
          "text": "风把雨和选择都推向边缘",
          "mood": "紧张"
        }
      ]
    },
    "S2": {
      "title": "逃离穹顶大厦",
      "lines": [
        {
          "speaker": "旁白",
          "text": "雨声里，楼道像裂开的喉咙",
          "mood": "压抑"
        },
        {
          "speaker": "林夏",
          "text": "走，别停，按我说的来",
          "mood": "冷静"
        },
        {
          "speaker": "陈默",
          "text": "两条路，电梯或消防梯",
          "mood": "隐忍"
        },
        {
          "speaker": "渡鸦",
          "text": "声音没有，步伐更近了",
          "mood": "冷笑"
        },
        {
          "speaker": "林小雨(电话)",
          "text": "我在下面等你们",
          "mood": "焦虑"
        },
        {
          "speaker": "旁白",
          "text": "门缝外，光线在跳动",
          "mood": "紧迫"
        }
      ]
    },
    "S3": {
      "title": "黎明对峙",
      "lines": [
        {
          "speaker": "旁白",
          "text": "光从天边撕下一刀清冷",
          "mood": "冷峻"
        },
        {
          "speaker": "林夏",
          "text": "别再藏着了，告诉我真相",
          "mood": "坚定"
        },
        {
          "speaker": "陈默",
          "text": "扳机拉起，只差一个决定",
          "mood": "隐忍"
        },
        {
          "speaker": "渡鸦",
          "text": "影子里有冷铁的味道",
          "mood": "冷笑"
        },
        {
          "speaker": "林小雨(电话)",
          "text": "姐，我不想失去你",
          "mood": "哀求"
        },
        {
          "speaker": "旁白",
          "text": "黎明下，所有赌注都归零",
          "mood": "凝重"
        }
      ]
    }
  },
