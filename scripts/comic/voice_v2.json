{"P1": [{"speaker": "林夏", "text": "别靠近——只换一次。", "emotion": "neutral", "audio": "/static/comic/voice/P1_0.mp3", "dur": 1.91}, {"speaker": "渡鸦", "text": "交换开始，别乱动。", "emotion": "neutral", "audio": "/static/comic/voice/P1_1.mp3", "dur": 2.23}, {"speaker": "林夏", "text": "看着接口，别做傻事。", "emotion": "angry", "audio": "/static/comic/voice/P1_2.mp3", "dur": 2.41}], "P2": [{"speaker": "陈默", "text": "别出声，你先安全走。", "emotion": "neutral", "audio": "/static/comic/voice/P2_0.mp3", "dur": 2.38}, {"speaker": "林小雨", "text": "我有证据，足够摧毁他们。", "emotion": "angry", "audio": "/static/comic/voice/P2_1.mp3", "dur": 2.81}, {"speaker": "陈默", "text": "别冲动，交给我掩护。", "emotion": "sad", "audio": "/static/comic/voice/P2_2.mp3", "dur": 2.41}], "P3": [{"speaker": "顾衡", "text": "天穹只要一个借口，就够了。", "emotion": "neutral", "audio": "/static/comic/voice/P3_0.mp3", "dur": 3.56}, {"speaker": "渡鸦", "text": "命令已下，执行即可。", "emotion": "neutral", "audio": "/static/comic/voice/P3_1.mp3", "dur": 2.34}, {"speaker": "顾衡", "text": "新港会按我想的改写。", "emotion": "disgusted", "audio": "/static/comic/voice/P3_2.mp3", "dur": 2.34}], "O_RA": [{"speaker": "林夏", "text": "给你，交换现在开始。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA_0.mp3", "dur": 2.81}, {"speaker": "渡鸦", "text": "拿好——别后悔。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA_1.mp3", "dur": 2.27}, {"speaker": "林夏", "text": "别低估我手里的东西。", "emotion": "angry", "audio": "/static/comic/voice/O_RA_2.mp3", "dur": 2.12}], "O_RB": [{"speaker": "林夏", "text": "请检查——照你说的来。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB_0.mp3", "dur": 2.34}, {"speaker": "渡鸦", "text": "你的手，看起来干净。", "emotion": "surprised", "audio": "/static/comic/voice/O_RB_1.mp3", "dur": 2.27}, {"speaker": "林夏", "text": "眼睛别只盯那颗芯片。", "emotion": "angry", "audio": "/static/comic/voice/O_RB_2.mp3", "dur": 2.3}], "O_RC": [{"speaker": "林夏", "text": "现在！投影启动！快跑！", "emotion": "fearful", "audio": "/static/comic/voice/O_RC_0.mp3", "dur": 4.0}, {"speaker": "陈默", "text": "掩护撤离，我来阻他们！", "emotion": "angry", "audio": "/static/comic/voice/O_RC_1.mp3", "dur": 2.02}, {"speaker": "渡鸦", "text": "别让他们跑了——射击！", "emotion": "angry", "audio": "/static/comic/voice/O_RC_2.mp3", "dur": 2.2}], "T_R": [{"speaker": "林小雨", "text": "姐姐，不能把牺牲留给我！", "emotion": "angry", "audio": "/static/comic/voice/T_R_0.mp3", "dur": 3.38}, {"speaker": "林夏", "text": "小雨，马上退开！太危险！", "emotion": "fearful", "audio": "/static/comic/voice/T_R_1.mp3", "dur": 3.42}, {"speaker": "林小雨", "text": "我会把星核交回给你！快跑！", "emotion": "angry", "audio": "/static/comic/voice/T_R_2.mp3", "dur": 3.49}], "O_RA1": [{"speaker": "林夏", "text": "这是你要的，拿着吧。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1_0.mp3", "dur": 2.95}, {"speaker": "渡鸦", "text": "交出——别耍花招。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA1_1.mp3", "dur": 2.74}, {"speaker": "林夏", "text": "我只给一次机会，别浪费。", "emotion": "angry", "audio": "/static/comic/voice/O_RA1_2.mp3", "dur": 2.45}], "O_RA2": [{"speaker": "林夏", "text": "不交换——星核不出我手。", "emotion": "angry", "audio": "/static/comic/voice/O_RA2_0.mp3", "dur": 3.46}, {"speaker": "渡鸦", "text": "你违背命令要付出代价。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2_1.mp3", "dur": 2.48}, {"speaker": "林夏", "text": "我说过，绝不伤我妹妹。", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2_2.mp3", "dur": 3.06}], "O_RA3": [{"speaker": "林夏", "text": "你拿的只是复制品。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3_0.mp3", "dur": 2.05}, {"speaker": "渡鸦", "text": "别耍花招，别骗我。", "emotion": "angry", "audio": "/static/comic/voice/O_RA3_1.mp3", "dur": 2.34}, {"speaker": "林夏", "text": "真核在我手心，懂吗？", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3_2.mp3", "dur": 1.91}], "T_RA": [{"speaker": "陈默", "text": "我曾在穹顶情报部工作。", "emotion": "sad", "audio": "/static/comic/voice/T_RA_0.mp3", "dur": 2.7}, {"speaker": "林夏", "text": "你早该告诉我们真相。", "emotion": "angry", "audio": "/static/comic/voice/T_RA_1.mp3", "dur": 2.05}, {"speaker": "陈默", "text": "我欠你们的，今夜算清。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA_2.mp3", "dur": 2.34}], "O_RA1a": [{"speaker": "林夏", "text": "保证林小雨安全！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1a_0.mp3", "dur": 1.76}, {"speaker": "渡鸦", "text": "我不做保证，你知规矩。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1a_1.mp3", "dur": 2.74}, {"speaker": "林夏", "text": "答应就交出星核！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA1a_2.mp3", "dur": 2.63}], "O_RA1b": [{"speaker": "林夏", "text": "把我留下，放她走！", "emotion": "sad", "audio": "/static/comic/voice/O_RA1b_0.mp3", "dur": 3.85}, {"speaker": "陈默", "text": "别自毁，你别这样！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1b_1.mp3", "dur": 1.84}, {"speaker": "林夏", "text": "这是我唯一筹码，别劝我。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1b_2.mp3", "dur": 2.27}], "O_RA1c": [{"speaker": "林夏", "text": "证据我会同时公开上传。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1c_0.mp3", "dur": 2.7}, {"speaker": "渡鸦", "text": "你以为你能躲过天穹？", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA1c_1.mp3", "dur": 2.3}, {"speaker": "林夏", "text": "不上传我就不给你星核！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1c_2.mp3", "dur": 2.23}], "T_RA1": [{"speaker": "林夏", "text": "别动！按我说的来。", "emotion": "angry", "audio": "/static/comic/voice/T_RA1_0.mp3", "dur": 2.02}, {"speaker": "林小雨", "text": "姐——你在干嘛？说清楚！", "emotion": "surprised", "audio": "/static/comic/voice/T_RA1_1.mp3", "dur": 3.1}, {"speaker": "林夏", "text": "跟我演戏，别出声，信我！", "emotion": "fearful", "audio": "/static/comic/voice/T_RA1_2.mp3", "dur": 3.64}], "O_RA1ax": [{"speaker": "林夏", "text": "走吧，别回头看我们。", "emotion": "sad", "audio": "/static/comic/voice/O_RA1ax_0.mp3", "dur": 2.77}, {"speaker": "陈默", "text": "暂时安全，别放松警惕。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1ax_1.mp3", "dur": 2.56}, {"speaker": "林夏", "text": "她安全了，但天穹还在盘旋。", "emotion": "fearful", "audio": "/static/comic/voice/O_RA1ax_2.mp3", "dur": 4.64}], "O_RA1ay": [{"speaker": "渡鸦", "text": "收下了，别挣扎。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1ay_0.mp3", "dur": 1.94}, {"speaker": "林夏", "text": "答应我——放过小雨！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1ay_1.mp3", "dur": 2.3}, {"speaker": "渡鸦", "text": "命令已下，定位曝光。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1ay_2.mp3", "dur": 2.2}, {"speaker": "陈默", "text": "别怕，我在这——", "emotion": "sad", "audio": "/static/comic/voice/O_RA1ay_3.mp3", "dur": 2.12}], "T_RA1a": [{"speaker": "林夏", "text": "不——拿回！", "emotion": "surprised", "audio": "/static/comic/voice/T_RA1a_0.mp3", "dur": 1.66}, {"speaker": "渡鸦", "text": "太迟了——", "emotion": "neutral", "audio": "/static/comic/voice/T_RA1a_1.mp3", "dur": 1.3}, {"speaker": "林夏", "text": "芯片掉了！", "emotion": "fearful", "audio": "/static/comic/voice/T_RA1a_2.mp3", "dur": 1.62}], "O_RA1bx": [{"speaker": "陈默", "text": "放开她，站住！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1bx_0.mp3", "dur": 1.8}, {"speaker": "渡鸦", "text": "多余的情绪，别送命。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA1bx_1.mp3", "dur": 2.95}, {"speaker": "林小雨", "text": "姐！快走，我来挡住他们！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA1bx_2.mp3", "dur": 2.95}, {"speaker": "林夏", "text": "走！别回头！芯片坏了！", "emotion": "sad", "audio": "/static/comic/voice/O_RA1bx_3.mp3", "dur": 3.89}], "T_RA1b": [{"speaker": "林夏", "text": "我不能拿你们当筹码。", "emotion": "sad", "audio": "/static/comic/voice/T_RA1b_0.mp3", "dur": 2.95}, {"speaker": "渡鸦", "text": "选择就是死亡。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA1b_1.mp3", "dur": 1.87}, {"speaker": "陈默", "text": "别做傻事，林夏！", "emotion": "angry", "audio": "/static/comic/voice/T_RA1b_2.mp3", "dur": 1.84}], "O_RA1cx": [{"speaker": "林夏", "text": "投影开始，备份启动！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1cx_0.mp3", "dur": 2.48}, {"speaker": "陈默", "text": "别停，继续传播！", "emotion": "surprised", "audio": "/static/comic/voice/O_RA1cx_1.mp3", "dur": 1.66}, {"speaker": "顾衡", "text": "你们以为有人会信？", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA1cx_2.mp3", "dur": 1.94}, {"speaker": "林夏", "text": "让人看见就行了。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1cx_3.mp3", "dur": 1.73}], "O_RA1cy": [{"speaker": "渡鸦", "text": "防火墙已断，上传中止。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1cy_0.mp3", "dur": 2.59}, {"speaker": "顾衡", "text": "真相会被分割，市场会消化它。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA1cy_1.mp3", "dur": 3.96}, {"speaker": "林夏", "text": "信息被吞了……我们还没完。", "emotion": "angry", "audio": "/static/comic/voice/O_RA1cy_2.mp3", "dur": 2.52}], "T_RA1c": [{"speaker": "林夏", "text": "先保全她，撤回镜像。", "emotion": "sad", "audio": "/static/comic/voice/T_RA1c_0.mp3", "dur": 3.46}, {"speaker": "陈默", "text": "你这是选了更长的路。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA1c_1.mp3", "dur": 2.16}, {"speaker": "林小雨", "text": "姐……我会等你们反击！", "emotion": "happy", "audio": "/static/comic/voice/T_RA1c_2.mp3", "dur": 2.74}], "O_RA2a": [{"speaker": "陈默", "text": "别动手——我来！", "emotion": "angry", "audio": "/static/comic/voice/O_RA2a_0.mp3", "dur": 1.44}, {"speaker": "渡鸦", "text": "又是个多余的英雄。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA2a_1.mp3", "dur": 2.34}, {"speaker": "陈默", "text": "别让他开枪，挡住狙击！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2a_2.mp3", "dur": 2.09}], "O_RA2b": [{"speaker": "林夏", "text": "你们不过是有壳的乌鸦。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2b_0.mp3", "dur": 3.1}, {"speaker": "渡鸦", "text": "挑衅？你会付出代价。", "emotion": "angry", "audio": "/static/comic/voice/O_RA2b_1.mp3", "dur": 3.06}, {"speaker": "林夏", "text": "露出真面目吧，我早料到你们。", "emotion": "surprised", "audio": "/static/comic/voice/O_RA2b_2.mp3", "dur": 3.85}], "O_RA2c": [{"speaker": "林夏", "text": "十秒后援兵到达。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2c_0.mp3", "dur": 2.41}, {"speaker": "渡鸦", "text": "假的信号——你在骗我。", "emotion": "surprised", "audio": "/static/comic/voice/O_RA2c_1.mp3", "dur": 2.23}, {"speaker": "林夏", "text": "犹豫一下就够我布网了。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2c_2.mp3", "dur": 2.41}], "T_RA2": [{"speaker": "林夏", "text": "看你每一步，我都能回放。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA2_0.mp3", "dur": 2.34}, {"speaker": "陈默", "text": "现在！逼他现身！", "emotion": "angry", "audio": "/static/comic/voice/T_RA2_1.mp3", "dur": 1.84}, {"speaker": "渡鸦", "text": "你以为这样就能赢？", "emotion": "disgusted", "audio": "/static/comic/voice/T_RA2_2.mp3", "dur": 2.16}], "O_RA2ax": [{"speaker": "陈默", "text": "快走！别停！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2ax_0.mp3", "dur": 1.87}, {"speaker": "林夏", "text": "别回头，带好星核！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2ax_1.mp3", "dur": 2.84}, {"speaker": "陈默", "text": "交给地下媒体，真相会播出。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2ax_2.mp3", "dur": 3.1}], "O_RA2ay": [{"speaker": "渡鸦", "text": "把芯片交给董事长。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2ay_0.mp3", "dur": 2.23}, {"speaker": "林夏", "text": "你们不会得逞，我会追回来！", "emotion": "angry", "audio": "/static/comic/voice/O_RA2ay_1.mp3", "dur": 2.45}, {"speaker": "林夏", "text": "小雨的位置……被暴露了！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2ay_2.mp3", "dur": 2.95}], "T_RA2a": [{"speaker": "陈默", "text": "走，别回头。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA2a_0.mp3", "dur": 2.05}, {"speaker": "林夏", "text": "有她安全就够了。", "emotion": "sad", "audio": "/static/comic/voice/T_RA2a_1.mp3", "dur": 2.7}, {"speaker": "陈默", "text": "别把希望交给别人，自己守住就行。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA2a_2.mp3", "dur": 3.49}], "O_RA2bx": [{"speaker": "陈默", "text": "说出你们的计划，快。", "emotion": "angry", "audio": "/static/comic/voice/O_RA2bx_0.mp3", "dur": 1.76}, {"speaker": "渡鸦", "text": "你们以为胜利了？只是开始。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA2bx_1.mp3", "dur": 3.49}, {"speaker": "林夏", "text": "说！顾衡的名字，全部交代。", "emotion": "angry", "audio": "/static/comic/voice/O_RA2bx_2.mp3", "dur": 2.56}], "O_RA2by": [{"speaker": "林夏", "text": "去告诉你的主人。", "emotion": "angry", "audio": "/static/comic/voice/O_RA2by_0.mp3", "dur": 1.84}, {"speaker": "渡鸦", "text": "放我走——我会回报的。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2by_1.mp3", "dur": 2.56}, {"speaker": "陈默", "text": "别高兴太早，这只是开场。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2by_2.mp3", "dur": 2.52}, {"speaker": "顾衡", "text": "你们玩火。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA2by_3.mp3", "dur": 1.51}], "T_RA2b": [{"speaker": "林夏", "text": "我们别无选择。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA2b_0.mp3", "dur": 1.58}, {"speaker": "陈默", "text": "街道被点燃了——太多人受伤！", "emotion": "angry", "audio": "/static/comic/voice/T_RA2b_1.mp3", "dur": 2.45}, {"speaker": "渡鸦", "text": "……", "emotion": "neutral", "audio": null, "dur": 1.2}], "O_RA2cx": [{"speaker": "林小雨", "text": "姐姐，谢谢。", "emotion": "happy", "audio": "/static/comic/voice/O_RA2cx_0.mp3", "dur": 1.94}, {"speaker": "林夏", "text": "保重，别参与报复。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA2cx_1.mp3", "dur": 2.59}, {"speaker": "陈默", "text": "快走！别回头！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2cx_2.mp3", "dur": 2.09}], "O_RA2cy": [{"speaker": "顾衡", "text": "别想逃。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA2cy_0.mp3", "dur": 1.51}, {"speaker": "林夏", "text": "分散撤离，掩护我！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA2cy_1.mp3", "dur": 2.92}, {"speaker": "陈默", "text": "我堵住左侧，你跑右侧！", "emotion": "angry", "audio": "/static/comic/voice/O_RA2cy_2.mp3", "dur": 2.45}], "T_RA2c": [{"speaker": "林小雨", "text": "姐！我被锁住了！", "emotion": "fearful", "audio": "/static/comic/voice/T_RA2c_0.mp3", "dur": 2.38}, {"speaker": "林夏", "text": "别放弃，等我。", "emotion": "angry", "audio": "/static/comic/voice/T_RA2c_1.mp3", "dur": 2.2}, {"speaker": "陈默", "text": "我冲上去，撑住她一刻钟！", "emotion": "angry", "audio": "/static/comic/voice/T_RA2c_2.mp3", "dur": 2.34}], "O_RA3a": [{"speaker": "林夏", "text": "价格不是问题。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3a_0.mp3", "dur": 1.98}, {"speaker": "林小雨", "text": "我要一起走！", "emotion": "angry", "audio": "/static/comic/voice/O_RA3a_1.mp3", "dur": 1.37}, {"speaker": "陈默", "text": "别天真，地下也有规则。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA3a_2.mp3", "dur": 2.92}], "O_RA3b": [{"speaker": "林夏", "text": "我要跟董事长谈判。", "emotion": "angry", "audio": "/static/comic/voice/O_RA3b_0.mp3", "dur": 1.73}, {"speaker": "顾衡", "text": "你走得很远。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA3b_1.mp3", "dur": 1.66}, {"speaker": "陈默", "text": "别被他吃掉，林夏。", "emotion": "fearful", "audio": "/static/comic/voice/O_RA3b_2.mp3", "dur": 2.09}], "O_RA3c": [{"speaker": "林夏", "text": "等到最合适的时机。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3c_0.mp3", "dur": 2.02}, {"speaker": "陈默", "text": "别让时间把我们吞掉。", "emotion": "sad", "audio": "/static/comic/voice/O_RA3c_1.mp3", "dur": 2.34}, {"speaker": "林小雨", "text": "我会守护芯片的，你放心。", "emotion": "happy", "audio": "/static/comic/voice/O_RA3c_2.mp3", "dur": 3.17}], "T_RA3": [{"speaker": "林夏", "text": "把它一分为二，成交一半。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA3_0.mp3", "dur": 2.45}, {"speaker": "顾衡", "text": "很好，半件足够威慑我。", "emotion": "happy", "audio": "/static/comic/voice/T_RA3_1.mp3", "dur": 3.06}, {"speaker": "林夏", "text": "另一半已送进城市节点。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA3_2.mp3", "dur": 2.16}, {"speaker": "顾衡", "text": "你以为这能反我？", "emotion": "disgusted", "audio": "/static/comic/voice/T_RA3_3.mp3", "dur": 2.74}], "O_RA3ax": [{"speaker": "林小雨", "text": "我走了，别来找我麻烦。", "emotion": "angry", "audio": "/static/comic/voice/O_RA3ax_0.mp3", "dur": 2.45}, {"speaker": "林夏", "text": "你远走，别回头——活着回来。", "emotion": "fearful", "audio": "/static/comic/voice/O_RA3ax_1.mp3", "dur": 3.92}, {"speaker": "林小雨", "text": "答应我，我会消失一段时间。", "emotion": "happy", "audio": "/static/comic/voice/O_RA3ax_2.mp3", "dur": 3.02}], "O_RA3ay": [{"speaker": "顾衡", "text": "这买家很靠谱——都是我们人。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA3ay_0.mp3", "dur": 3.31}, {"speaker": "林夏", "text": "你们别想得逞，星核还在我手上！", "emotion": "angry", "audio": "/static/comic/voice/O_RA3ay_1.mp3", "dur": 2.92}, {"speaker": "顾衡", "text": "别急，交出芯片，你妹妹就安全。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3ay_2.mp3", "dur": 3.56}, {"speaker": "林夏", "text": "不！你们不会得逞！", "emotion": "angry", "audio": "/static/comic/voice/O_RA3ay_3.mp3", "dur": 1.98}], "T_RA3a": [{"speaker": "林夏", "text": "没人能用它——我毁了。", "emotion": "angry", "audio": "/static/comic/voice/T_RA3a_0.mp3", "dur": 2.7}, {"speaker": "林小雨", "text": "你要烧掉证据？为什么！", "emotion": "surprised", "audio": "/static/comic/voice/T_RA3a_1.mp3", "dur": 2.95}, {"speaker": "林夏", "text": "宁可灰烬，也不让他们控制它。", "emotion": "angry", "audio": "/static/comic/voice/T_RA3a_2.mp3", "dur": 3.06}], "O_RA3bx": [{"speaker": "顾衡", "text": "记住，你付出的代价很重。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RA3bx_0.mp3", "dur": 3.35}, {"speaker": "林夏", "text": "只要妹妹安全，其它都可以谈判。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3bx_1.mp3", "dur": 2.81}, {"speaker": "顾衡", "text": "很好，给你们一张免死牌。", "emotion": "happy", "audio": "/static/comic/voice/O_RA3bx_2.mp3", "dur": 2.84}], "O_RA3by": [{"speaker": "顾衡", "text": "听好了，你现在是穹顶的人。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3by_0.mp3", "dur": 3.35}, {"speaker": "林夏", "text": "我不会成为你们的帮凶！", "emotion": "angry", "audio": "/static/comic/voice/O_RA3by_1.mp3", "dur": 1.91}, {"speaker": "顾衡", "text": "封存星核，欢迎加入穹顶。", "emotion": "happy", "audio": "/static/comic/voice/O_RA3by_2.mp3", "dur": 3.24}], "T_RA3b": [{"speaker": "陈默", "text": "别信他的承诺，别上当。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA3b_0.mp3", "dur": 2.41}, {"speaker": "林夏", "text": "表面收编，暗里我们再卖一个给地下。", "emotion": "angry", "audio": "/static/comic/voice/T_RA3b_1.mp3", "dur": 3.89}, {"speaker": "陈默", "text": "危险，但这是我们唯一机会。", "emotion": "fearful", "audio": "/static/comic/voice/T_RA3b_2.mp3", "dur": 3.02}], "O_RA3cx": [{"speaker": "林夏", "text": "星核藏好，等时机揭露它。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3cx_0.mp3", "dur": 3.46}, {"speaker": "陈默", "text": "我陪你潜伏，等一个机会。", "emotion": "sad", "audio": "/static/comic/voice/O_RA3cx_1.mp3", "dur": 3.56}, {"speaker": "林夏", "text": "生活会被推向对抗，但我们不放弃。", "emotion": "angry", "audio": "/static/comic/voice/O_RA3cx_2.mp3", "dur": 3.82}], "O_RA3cy": [{"speaker": "渡鸦", "text": "没有藏匿可言。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3cy_0.mp3", "dur": 1.55}, {"speaker": "林夏", "text": "无人机来了——星核被炸碎了！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA3cy_1.mp3", "dur": 4.07}, {"speaker": "渡鸦", "text": "你妹妹已被定位。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA3cy_2.mp3", "dur": 1.66}, {"speaker": "林夏", "text": "我每走一步都可能死。", "emotion": "fearful", "audio": "/static/comic/voice/O_RA3cy_3.mp3", "dur": 2.66}], "T_RA3c": [{"speaker": "林小雨", "text": "姐，你疯了吗？把地点暴露？", "emotion": "angry", "audio": "/static/comic/voice/T_RA3c_0.mp3", "dur": 4.9}, {"speaker": "林夏", "text": "这是换你安全的唯一筹码。", "emotion": "neutral", "audio": "/static/comic/voice/T_RA3c_1.mp3", "dur": 2.38}, {"speaker": "林小雨", "text": "官方现在把我列为特别保护？", "emotion": "surprised", "audio": "/static/comic/voice/T_RA3c_2.mp3", "dur": 2.88}, {"speaker": "林夏", "text": "我赌一次——你要活着离开。", "emotion": "angry", "audio": "/static/comic/voice/T_RA3c_3.mp3", "dur": 3.17}], "O_RB1": [{"speaker": "林夏", "text": "拿好，别试探——别出声。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1_0.mp3", "dur": 2.48}, {"speaker": "渡鸦", "text": "你以为偷换能瞒过我？", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB1_1.mp3", "dur": 2.45}, {"speaker": "林夏", "text": "别动手，交易按规矩来。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1_2.mp3", "dur": 2.59}], "O_RB2": [{"speaker": "林夏", "text": "糟糕……（故作惊慌）", "emotion": "surprised", "audio": "/static/comic/voice/O_RB2_0.mp3", "dur": 2.63}, {"speaker": "渡鸦", "text": "别动！别想捡起来。", "emotion": "angry", "audio": "/static/comic/voice/O_RB2_1.mp3", "dur": 2.16}, {"speaker": "林夏", "text": "我只是手滑，别冲动。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2_2.mp3", "dur": 2.41}], "O_RB3": [{"speaker": "林夏", "text": "全城都应该知道真相！", "emotion": "angry", "audio": "/static/comic/voice/O_RB3_0.mp3", "dur": 2.02}, {"speaker": "顾衡", "text": "你以为这样就能胜利？别天真。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB3_1.mp3", "dur": 3.35}, {"speaker": "林夏", "text": "我不求胜利，只求揭露。", "emotion": "angry", "audio": "/static/comic/voice/O_RB3_2.mp3", "dur": 2.63}], "T_RB": [{"speaker": "林夏", "text": "或许这只是镜像，真芯片早被分散。", "emotion": "neutral", "audio": "/static/comic/voice/T_RB_0.mp3", "dur": 4.86}, {"speaker": "渡鸦", "text": "你在欺骗谁？自己吗？", "emotion": "disgusted", "audio": "/static/comic/voice/T_RB_1.mp3", "dur": 3.06}, {"speaker": "林夏", "text": "每一步都是赌——真假与代价。", "emotion": "sad", "audio": "/static/comic/voice/T_RB_2.mp3", "dur": 5.58}], "O_RB1a": [{"speaker": "林夏", "text": "把重点看这儿——看我的腕口。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1a_0.mp3", "dur": 2.41}, {"speaker": "渡鸦", "text": "视线短暂偏移……", "emotion": "surprised", "audio": "/static/comic/voice/O_RB1a_1.mp3", "dur": 1.76}, {"speaker": "林夏", "text": "别转头，别多看其他东西。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1a_2.mp3", "dur": 3.02}], "O_RB1b": [{"speaker": "渡鸦", "text": "放手让我看清楚它。", "emotion": "angry", "audio": "/static/comic/voice/O_RB1b_0.mp3", "dur": 2.41}, {"speaker": "林夏", "text": "你只看这一样，不许摸别的。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1b_1.mp3", "dur": 2.77}, {"speaker": "渡鸦", "text": "好，我只看这一样，你别骗我。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1b_2.mp3", "dur": 3.74}], "T_RB1": [{"speaker": "林夏", "text": "你们要真相？现在给你们。", "emotion": "angry", "audio": "/static/comic/voice/T_RB1_0.mp3", "dur": 2.92}, {"speaker": "渡鸦", "text": "他妈的——怎么可能？", "emotion": "surprised", "audio": "/static/comic/voice/T_RB1_1.mp3", "dur": 2.12}, {"speaker": "陈默", "text": "别开枪——别再动！", "emotion": "fearful", "audio": "/static/comic/voice/T_RB1_2.mp3", "dur": 1.91}], "O_RB1ax": [{"speaker": "陈默", "text": "快走，巷子里有雾。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1ax_0.mp3", "dur": 2.02}, {"speaker": "林夏", "text": "小雨要安全——明白？", "emotion": "angry", "audio": "/static/comic/voice/O_RB1ax_1.mp3", "dur": 2.74}, {"speaker": "陈默", "text": "我挡着，你跑！", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1ax_2.mp3", "dur": 1.76}], "O_RB1ay": [{"speaker": "渡鸦", "text": "不可能……那枪！", "emotion": "surprised", "audio": "/static/comic/voice/O_RB1ay_0.mp3", "dur": 2.3}, {"speaker": "林夏", "text": "别躺下！撑住！", "emotion": "angry", "audio": "/static/comic/voice/O_RB1ay_1.mp3", "dur": 1.62}, {"speaker": "陈默", "text": "你先活着——我来挡！", "emotion": "sad", "audio": "/static/comic/voice/O_RB1ay_2.mp3", "dur": 2.7}], "T_RB1a": [{"speaker": "林夏", "text": "够了，别再牺牲了！", "emotion": "angry", "audio": "/static/comic/voice/T_RB1a_0.mp3", "dur": 2.2}, {"speaker": "渡鸦", "text": "你要逃？", "emotion": "neutral", "audio": "/static/comic/voice/T_RB1a_1.mp3", "dur": 1.26}, {"speaker": "陈默", "text": "上车！快！", "emotion": "fearful", "audio": "/static/comic/voice/T_RB1a_2.mp3", "dur": 1.44}], "O_RB1bx": [{"speaker": "渡鸦", "text": "停下——这东西不能放！", "emotion": "angry", "audio": "/static/comic/voice/O_RB1bx_0.mp3", "dur": 2.45}, {"speaker": "顾衡", "text": "以为这样能翻盘？别天真。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB1bx_1.mp3", "dur": 3.56}, {"speaker": "林小雨", "text": "真相已经出来了！", "emotion": "angry", "audio": "/static/comic/voice/O_RB1bx_2.mp3", "dur": 2.16}], "O_RB1by": [{"speaker": "渡鸦", "text": "把那段日志给我！", "emotion": "neutral", "audio": "/static/comic/voice/O_RB1by_0.mp3", "dur": 1.73}, {"speaker": "林夏", "text": "你欠我时间，不欠别的。", "emotion": "angry", "audio": "/static/comic/voice/O_RB1by_1.mp3", "dur": 2.45}, {"speaker": "林小雨", "text": "离开，我走了！", "emotion": "surprised", "audio": "/static/comic/voice/O_RB1by_2.mp3", "dur": 2.16}], "T_RB1b": [{"speaker": "林夏", "text": "带她走，求你了。", "emotion": "sad", "audio": "/static/comic/voice/T_RB1b_0.mp3", "dur": 2.95}, {"speaker": "渡鸦", "text": "你删了关键段？", "emotion": "disgusted", "audio": "/static/comic/voice/T_RB1b_1.mp3", "dur": 1.69}, {"speaker": "林夏", "text": "换她的自由——换我一辈子沉默。", "emotion": "sad", "audio": "/static/comic/voice/T_RB1b_2.mp3", "dur": 4.21}], "O_RB2a": [{"speaker": "林夏", "text": "现在！雾幕启动！", "emotion": "angry", "audio": "/static/comic/voice/O_RB2a_0.mp3", "dur": 1.98}, {"speaker": "陈默", "text": "冲！别给他们喘息！", "emotion": "angry", "audio": "/static/comic/voice/O_RB2a_1.mp3", "dur": 2.02}, {"speaker": "渡鸦", "text": "这里视线被切断了！", "emotion": "surprised", "audio": "/static/comic/voice/O_RB2a_2.mp3", "dur": 1.87}], "O_RB2b": [{"speaker": "林夏", "text": "带走我，放了小雨。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2b_0.mp3", "dur": 2.34}, {"speaker": "渡鸦", "text": "你真敢赌命。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2b_1.mp3", "dur": 1.62}, {"speaker": "林夏", "text": "赌她能活着离开吧。", "emotion": "fearful", "audio": "/static/comic/voice/O_RB2b_2.mp3", "dur": 2.23}], "T_RB2": [{"speaker": "渡鸦", "text": "别演戏，我看清了。", "emotion": "disgusted", "audio": "/static/comic/voice/T_RB2_0.mp3", "dur": 2.27}, {"speaker": "渡鸦", "text": "灯光来了，别多想了。", "emotion": "neutral", "audio": "/static/comic/voice/T_RB2_1.mp3", "dur": 2.41}, {"speaker": "林夏", "text": "监控……被触发了？", "emotion": "surprised", "audio": "/static/comic/voice/T_RB2_2.mp3", "dur": 2.2}], "O_RB2ax": [{"speaker": "陈默", "text": "把星核先藏好！", "emotion": "fearful", "audio": "/static/comic/voice/O_RB2ax_0.mp3", "dur": 1.73}, {"speaker": "林夏", "text": "小雨先带走！跟我走！", "emotion": "angry", "audio": "/static/comic/voice/O_RB2ax_1.mp3", "dur": 2.27}, {"speaker": "陈默", "text": "掩护我，别回头！", "emotion": "angry", "audio": "/static/comic/voice/O_RB2ax_2.mp3", "dur": 1.73}], "O_RB2ay": [{"speaker": "渡鸦", "text": "愚蠢的人类。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB2ay_0.mp3", "dur": 1.73}, {"speaker": "陈默", "text": "别再动！把枪扔下！", "emotion": "angry", "audio": "/static/comic/voice/O_RB2ay_1.mp3", "dur": 1.62}, {"speaker": "林夏", "text": "挡住他，我去拿枪！", "emotion": "angry", "audio": "/static/comic/voice/O_RB2ay_2.mp3", "dur": 1.8}], "T_RB2a": [{"speaker": "林夏", "text": "不——那里有监护楼！", "emotion": "surprised", "audio": "/static/comic/voice/T_RB2a_0.mp3", "dur": 2.16}, {"speaker": "林夏", "text": "我触发了陷阱……", "emotion": "sad", "audio": "/static/comic/voice/T_RB2a_1.mp3", "dur": 2.56}, {"speaker": "陈默", "text": "收声！我们得赶快撤！", "emotion": "fearful", "audio": "/static/comic/voice/T_RB2a_2.mp3", "dur": 2.12}], "O_RB2bx": [{"speaker": "渡鸦", "text": "这条内部通话，够证据吗？", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2bx_0.mp3", "dur": 2.77}, {"speaker": "林夏", "text": "够了，先救小雨！快放她！", "emotion": "fearful", "audio": "/static/comic/voice/O_RB2bx_1.mp3", "dur": 3.46}, {"speaker": "渡鸦", "text": "按协议，放人。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2bx_2.mp3", "dur": 2.23}], "O_RB2by": [{"speaker": "林小雨", "text": "姐，你没事吧？快回我！", "emotion": "fearful", "audio": "/static/comic/voice/O_RB2by_0.mp3", "dur": 3.24}, {"speaker": "林夏", "text": "我在，别动，别哭！", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2by_1.mp3", "dur": 2.12}, {"speaker": "渡鸦", "text": "好了，走开。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB2by_2.mp3", "dur": 1.69}], "T_RB2b": [{"speaker": "林小雨", "text": "姐！别走！不要被带走！", "emotion": "fearful", "audio": "/static/comic/voice/T_RB2b_0.mp3", "dur": 3.24}, {"speaker": "林夏", "text": "小雨——别靠近我，快躲开！", "emotion": "angry", "audio": "/static/comic/voice/T_RB2b_1.mp3", "dur": 2.52}, {"speaker": "渡鸦", "text": "闭嘴——你们都成了样本。", "emotion": "disgusted", "audio": "/static/comic/voice/T_RB2b_2.mp3", "dur": 3.02}], "O_RB3a": [{"speaker": "顾衡", "text": "让这夜安静下来。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB3a_0.mp3", "dur": 2.27}, {"speaker": "渡鸦", "text": "收到，开镜。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB3a_1.mp3", "dur": 1.58}, {"speaker": "顾衡", "text": "城市会替我清算。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB3a_2.mp3", "dur": 2.09}], "O_RB3b": [{"speaker": "顾衡", "text": "别急，交给法庭审理。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB3b_0.mp3", "dur": 2.81}, {"speaker": "林小雨", "text": "法庭能压死他们吗？", "emotion": "angry", "audio": "/static/comic/voice/O_RB3b_1.mp3", "dur": 2.74}, {"speaker": "顾衡", "text": "法律和钱，可以慢慢绞。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB3b_2.mp3", "dur": 3.46}], "T_RB3": [{"speaker": "顾衡", "text": "天穹已接管秩序。", "emotion": "neutral", "audio": "/static/comic/voice/T_RB3_0.mp3", "dur": 2.16}, {"speaker": "林夏", "text": "无人机灯阵上来了——", "emotion": "surprised", "audio": "/static/comic/voice/T_RB3_1.mp3", "dur": 1.94}, {"speaker": "陈默", "text": "所有路都被重排了！", "emotion": "fearful", "audio": "/static/comic/voice/T_RB3_2.mp3", "dur": 2.27}], "O_RB3ax": [{"speaker": "林夏", "text": "快走！别回头看我。", "emotion": "fearful", "audio": "/static/comic/voice/O_RB3ax_0.mp3", "dur": 2.81}, {"speaker": "陈默", "text": "把她带走，我挡住子弹！", "emotion": "angry", "audio": "/static/comic/voice/O_RB3ax_1.mp3", "dur": 2.05}, {"speaker": "林小雨", "text": "姐——我不走不行吗？", "emotion": "sad", "audio": "/static/comic/voice/O_RB3ax_2.mp3", "dur": 3.02}], "O_RB3ay": [{"speaker": "渡鸦", "text": "结束这场闹剧。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB3ay_0.mp3", "dur": 2.12}, {"speaker": "林夏", "text": "真相不能随你消失！", "emotion": "angry", "audio": "/static/comic/voice/O_RB3ay_1.mp3", "dur": 2.05}, {"speaker": "渡鸦", "text": "那就陪我下去吧。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB3ay_2.mp3", "dur": 1.8}], "T_RB3a": [{"speaker": "顾衡", "text": "别开枪，留着她。", "emotion": "disgusted", "audio": "/static/comic/voice/T_RB3a_0.mp3", "dur": 2.56}, {"speaker": "渡鸦", "text": "指令收回，暂停狙击。", "emotion": "neutral", "audio": "/static/comic/voice/T_RB3a_1.mp3", "dur": 2.45}, {"speaker": "林夏", "text": "你想把我们带去哪儿？", "emotion": "angry", "audio": "/static/comic/voice/T_RB3a_2.mp3", "dur": 1.69}], "O_RB3bx": [{"speaker": "林夏", "text": "把星核交给法律，公审它。", "emotion": "angry", "audio": "/static/comic/voice/O_RB3bx_0.mp3", "dur": 2.63}, {"speaker": "顾衡", "text": "你以为这就完了？这只是开始。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RB3bx_1.mp3", "dur": 3.64}, {"speaker": "陈默", "text": "庭审会是新港的裂缝。", "emotion": "neutral", "audio": "/static/comic/voice/O_RB3bx_2.mp3", "dur": 2.7}], "O_RB3by": [{"speaker": "林夏", "text": "我们要走，先把证据备份。", "emotion": "angry", "audio": "/static/comic/voice/O_RB3by_0.mp3", "dur": 3.17}, {"speaker": "林小雨", "text": "我会学会保护你们和真相！", "emotion": "happy", "audio": "/static/comic/voice/O_RB3by_1.mp3", "dur": 3.17}, {"speaker": "陈默", "text": "上船，别拖泥带水。", "emotion": "fearful", "audio": "/static/comic/voice/O_RB3by_2.mp3", "dur": 2.05}], "T_RB3b": [{"speaker": "林夏", "text": "有人出卖了星核去向。", "emotion": "angry", "audio": "/static/comic/voice/T_RB3b_0.mp3", "dur": 2.16}, {"speaker": "顾衡", "text": "抱歉，这比革命更值钱。", "emotion": "neutral", "audio": "/static/comic/voice/T_RB3b_1.mp3", "dur": 2.77}, {"speaker": "陈默", "text": "星核只回收了一部分？", "emotion": "surprised", "audio": "/static/comic/voice/T_RB3b_2.mp3", "dur": 1.91}, {"speaker": "林夏", "text": "真相残缺，我带着妹妹逃。", "emotion": "fearful", "audio": "/static/comic/voice/T_RB3b_3.mp3", "dur": 3.6}], "O_RC1": [{"speaker": "林夏", "text": "现在，跟我走！", "emotion": "fearful", "audio": "/static/comic/voice/O_RC1_0.mp3", "dur": 2.02}, {"speaker": "陈默", "text": "别带着小雨冲动！", "emotion": "angry", "audio": "/static/comic/voice/O_RC1_1.mp3", "dur": 1.44}, {"speaker": "林小雨", "text": "姐，我不会被丢下！", "emotion": "fearful", "audio": "/static/comic/voice/O_RC1_2.mp3", "dur": 3.35}], "O_RC2": [{"speaker": "林夏", "text": "把星核插进去，让城里看见！", "emotion": "angry", "audio": "/static/comic/voice/O_RC2_0.mp3", "dur": 2.84}, {"speaker": "顾衡", "text": "你以为他们会相信屏幕？", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC2_1.mp3", "dur": 2.23}, {"speaker": "陈默", "text": "别指望只靠投影平息一切。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC2_2.mp3", "dur": 2.34}], "O_RC3": [{"speaker": "顾衡", "text": "你把我当成了剧终的反派？", "emotion": "neutral", "audio": "/static/comic/voice/O_RC3_0.mp3", "dur": 2.45}, {"speaker": "林夏", "text": "别绕弯，我只要一个答案！", "emotion": "angry", "audio": "/static/comic/voice/O_RC3_1.mp3", "dur": 3.06}, {"speaker": "顾衡", "text": "答案？你要的是毁掉我帝国？", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC3_2.mp3", "dur": 5.26}], "T_RC": [{"speaker": "陈默", "text": "它在干预我们的选择，动了回溯。", "emotion": "surprised", "audio": "/static/comic/voice/T_RC_0.mp3", "dur": 2.95}, {"speaker": "林夏", "text": "天穹开始改写影像，别被洗掉！", "emotion": "angry", "audio": "/static/comic/voice/T_RC_1.mp3", "dur": 2.81}, {"speaker": "顾衡", "text": "天穹会保护自己，你们只是棋子。", "emotion": "neutral", "audio": "/static/comic/voice/T_RC_2.mp3", "dur": 3.74}], "O_RC1a": [{"speaker": "林小雨", "text": "姐，你会带我走吗？", "emotion": "fearful", "audio": "/static/comic/voice/O_RC1a_0.mp3", "dur": 2.88}, {"speaker": "林夏", "text": "永远，不许我失去你！", "emotion": "angry", "audio": "/static/comic/voice/O_RC1a_1.mp3", "dur": 2.48}, {"speaker": "陈默", "text": "快走，楼梯口被封了就完了！", "emotion": "fearful", "audio": "/static/comic/voice/O_RC1a_2.mp3", "dur": 2.48}], "O_RC1b": [{"speaker": "林夏", "text": "我来引开他们，掩护你们撤退。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1b_0.mp3", "dur": 2.41}, {"speaker": "陈默", "text": "别做傻事，你一个人拦不住渡鸦！", "emotion": "angry", "audio": "/static/comic/voice/O_RC1b_1.mp3", "dur": 2.92}, {"speaker": "林夏", "text": "我没有选择，快走！", "emotion": "fearful", "audio": "/static/comic/voice/O_RC1b_2.mp3", "dur": 2.66}], "T_RC1": [{"speaker": "渡鸦", "text": "目标：林夏，确认捕获优先。", "emotion": "neutral", "audio": "/static/comic/voice/T_RC1_0.mp3", "dur": 3.35}, {"speaker": "林夏", "text": "渡鸦……他来干什么？", "emotion": "surprised", "audio": "/static/comic/voice/T_RC1_1.mp3", "dur": 2.56}, {"speaker": "陈默", "text": "小心狙击，别露头！", "emotion": "fearful", "audio": "/static/comic/voice/T_RC1_2.mp3", "dur": 1.94}], "O_RC1ax": [{"speaker": "陈默", "text": "现在别冲动，等机会。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1ax_0.mp3", "dur": 2.34}, {"speaker": "林夏", "text": "别让我妹妹受一点伤！", "emotion": "angry", "audio": "/static/comic/voice/O_RC1ax_1.mp3", "dur": 2.02}, {"speaker": "陈默", "text": "你守着星核，我守着出口。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1ax_2.mp3", "dur": 2.74}], "O_RC1ay": [{"speaker": "林夏", "text": "我要你们的人脉和后路。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1ay_0.mp3", "dur": 2.12}, {"speaker": "陈默", "text": "别把信任当筹码，先立规矩。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1ay_1.mp3", "dur": 2.74}, {"speaker": "林夏", "text": "欠债有价，但小雨不在账上。", "emotion": "angry", "audio": "/static/comic/voice/O_RC1ay_2.mp3", "dur": 3.1}], "T_RC1a": [{"speaker": "林夏", "text": "天台上又有人开枪！", "emotion": "surprised", "audio": "/static/comic/voice/T_RC1a_0.mp3", "dur": 2.2}, {"speaker": "林夏", "text": "我手里的东西不能丢。", "emotion": "fearful", "audio": "/static/comic/voice/T_RC1a_1.mp3", "dur": 2.84}, {"speaker": "陈默", "text": "别回头，别被叫回去！", "emotion": "angry", "audio": "/static/comic/voice/T_RC1a_2.mp3", "dur": 1.84}], "O_RC1bx": [{"speaker": "渡鸦", "text": "结束了。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1bx_0.mp3", "dur": 1.22}, {"speaker": "林夏", "text": "小雨——别动！", "emotion": "fearful", "audio": "/static/comic/voice/O_RC1bx_1.mp3", "dur": 1.98}, {"speaker": "渡鸦", "text": "你太执着了，林夏。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC1bx_2.mp3", "dur": 2.56}], "O_RC1by": [{"speaker": "陈默", "text": "别动，我来了！", "emotion": "angry", "audio": "/static/comic/voice/O_RC1by_0.mp3", "dur": 1.33}, {"speaker": "渡鸦", "text": "陷阱里的人，别想逃。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC1by_1.mp3", "dur": 2.34}, {"speaker": "林夏", "text": "星核拿回来了，别松手。", "emotion": "happy", "audio": "/static/comic/voice/O_RC1by_2.mp3", "dur": 2.59}], "T_RC1b": [{"speaker": "林夏", "text": "快走，带小雨离开！", "emotion": "fearful", "audio": "/static/comic/voice/T_RC1b_0.mp3", "dur": 2.2}, {"speaker": "陈默", "text": "别傻站着，我来堵枪口！", "emotion": "angry", "audio": "/static/comic/voice/T_RC1b_1.mp3", "dur": 2.05}, {"speaker": "林小雨", "text": "姐——我不走不开！", "emotion": "fearful", "audio": "/static/comic/voice/T_RC1b_2.mp3", "dur": 2.12}], "O_RC2a": [{"speaker": "林小雨", "text": "大家都看见真相了！", "emotion": "surprised", "audio": "/static/comic/voice/O_RC2a_0.mp3", "dur": 2.02}, {"speaker": "顾衡", "text": "你毁了我的计划，真大胆。", "emotion": "angry", "audio": "/static/comic/voice/O_RC2a_1.mp3", "dur": 2.74}, {"speaker": "林小雨", "text": "他们该知道代价了！", "emotion": "angry", "audio": "/static/comic/voice/O_RC2a_2.mp3", "dur": 2.34}], "O_RC2b": [{"speaker": "林夏", "text": "先露这段，别全放光。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC2b_0.mp3", "dur": 2.7}, {"speaker": "顾衡", "text": "不错，留手更危险。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC2b_1.mp3", "dur": 3.06}, {"speaker": "林夏", "text": "等他们震惊后，再抽牌。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC2b_2.mp3", "dur": 2.56}], "T_RC2": [{"speaker": "林小雨", "text": "看清了吗？他们的真面目！", "emotion": "angry", "audio": "/static/comic/voice/T_RC2_0.mp3", "dur": 3.1}, {"speaker": "林小雨", "text": "我把全部证据挂出来了！", "emotion": "surprised", "audio": "/static/comic/voice/T_RC2_1.mp3", "dur": 2.38}, {"speaker": "林小雨", "text": "大家转发！别让他们掩盖！", "emotion": "fearful", "audio": "/static/comic/voice/T_RC2_2.mp3", "dur": 2.74}], "O_RC2ax": [{"speaker": "林夏", "text": "星核在我这里，先走！", "emotion": "neutral", "audio": "/static/comic/voice/O_RC2ax_0.mp3", "dur": 2.63}, {"speaker": "林小雨", "text": "这一次，我替你挡火！", "emotion": "angry", "audio": "/static/comic/voice/O_RC2ax_1.mp3", "dur": 2.45}, {"speaker": "林夏", "text": "别拖我，抗议会继续燃烧！", "emotion": "surprised", "audio": "/static/comic/voice/O_RC2ax_2.mp3", "dur": 2.63}], "O_RC2ay": [{"speaker": "陈默", "text": "你真要留下来挨捕？", "emotion": "fearful", "audio": "/static/comic/voice/O_RC2ay_0.mp3", "dur": 1.98}, {"speaker": "林夏", "text": "让我当众把他们撕开！", "emotion": "angry", "audio": "/static/comic/voice/O_RC2ay_1.mp3", "dur": 2.05}, {"speaker": "林夏", "text": "我愿意成为那道光……", "emotion": "sad", "audio": "/static/comic/voice/O_RC2ay_2.mp3", "dur": 2.34}], "T_RC2a": [{"speaker": "林夏", "text": "影像被篡改了——", "emotion": "disgusted", "audio": "/static/comic/voice/T_RC2a_0.mp3", "dur": 2.3}, {"speaker": "林夏", "text": "关键那段没了，星核备份呢？", "emotion": "fearful", "audio": "/static/comic/voice/T_RC2a_1.mp3", "dur": 4.21}, {"speaker": "林夏", "text": "我要回去取证，不能放过一秒！", "emotion": "angry", "audio": "/static/comic/voice/T_RC2a_2.mp3", "dur": 2.45}], "O_RC2bx": [{"speaker": "顾衡", "text": "以为曝光就能终结一切？", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC2bx_0.mp3", "dur": 2.59}, {"speaker": "林夏", "text": "我要把你们的网络撕开！", "emotion": "angry", "audio": "/static/comic/voice/O_RC2bx_1.mp3", "dur": 2.2}, {"speaker": "林夏", "text": "让公众看到全部真相！", "emotion": "surprised", "audio": "/static/comic/voice/O_RC2bx_2.mp3", "dur": 2.38}], "O_RC2by": [{"speaker": "陈默", "text": "把关键备份留着，先换人质。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC2by_0.mp3", "dur": 2.84}, {"speaker": "林夏", "text": "我不会拿小雨去赌！", "emotion": "angry", "audio": "/static/comic/voice/O_RC2by_1.mp3", "dur": 2.41}, {"speaker": "陈默", "text": "妥协只是为了活下去，别忘初衷。", "emotion": "sad", "audio": "/static/comic/voice/O_RC2by_2.mp3", "dur": 4.18}], "T_RC2b": [{"speaker": "林夏", "text": "备用上传被切断了！", "emotion": "fearful", "audio": "/static/comic/voice/T_RC2b_0.mp3", "dur": 2.63}, {"speaker": "林夏", "text": "天穹在反制，比想象更狠。", "emotion": "disgusted", "audio": "/static/comic/voice/T_RC2b_1.mp3", "dur": 3.82}, {"speaker": "林夏", "text": "我得另想办法，不能放弃！", "emotion": "angry", "audio": "/static/comic/voice/T_RC2b_2.mp3", "dur": 2.2}], "O_RC3a": [{"speaker": "林夏", "text": "顾衡，把脸抬起来，看清真相！", "emotion": "angry", "audio": "/static/comic/voice/O_RC3a_0.mp3", "dur": 3.28}, {"speaker": "顾衡", "text": "我所做的一切，为了城市秩序。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC3a_1.mp3", "dur": 3.64}, {"speaker": "林夏", "text": "秩序？你用生命当实验！", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC3a_2.mp3", "dur": 2.92}], "O_RC3b": [{"speaker": "林夏", "text": "星核在我手里，听清楚！", "emotion": "angry", "audio": "/static/comic/voice/O_RC3b_0.mp3", "dur": 2.59}, {"speaker": "林夏", "text": "停止人体实验，放人安全离开。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC3b_1.mp3", "dur": 3.06}, {"speaker": "顾衡", "text": "你这是要把我逼急了？", "emotion": "surprised", "audio": "/static/comic/voice/O_RC3b_2.mp3", "dur": 1.94}, {"speaker": "顾衡", "text": "答应你？这代价……太高了。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC3b_3.mp3", "dur": 4.75}], "T_RC3": [{"speaker": "渡鸦", "text": "别动——再动就开枪。", "emotion": "neutral", "audio": "/static/comic/voice/T_RC3_0.mp3", "dur": 2.27}, {"speaker": "渡鸦", "text": "红点在你们头上，听见了吗？", "emotion": "neutral", "audio": "/static/comic/voice/T_RC3_1.mp3", "dur": 2.38}, {"speaker": "渡鸦", "text": "想戏多了，会有人死的。", "emotion": "fearful", "audio": "/static/comic/voice/T_RC3_2.mp3", "dur": 3.02}], "O_RC3ax": [{"speaker": "顾衡", "text": "我们会内部调整，换掉几个人。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC3ax_0.mp3", "dur": 3.06}, {"speaker": "顾衡", "text": "你要的保证，可以给个软着陆。", "emotion": "happy", "audio": "/static/comic/voice/O_RC3ax_1.mp3", "dur": 2.52}, {"speaker": "林夏", "text": "别用人换皮，我盯着你。", "emotion": "angry", "audio": "/static/comic/voice/O_RC3ax_2.mp3", "dur": 2.27}], "O_RC3ay": [{"speaker": "顾衡", "text": "你别傻了，这局你赢不了。", "emotion": "disgusted", "audio": "/static/comic/voice/O_RC3ay_0.mp3", "dur": 3.74}, {"speaker": "林夏", "text": "真相会被看见，你逃不掉。", "emotion": "angry", "audio": "/static/comic/voice/O_RC3ay_1.mp3", "dur": 2.77}, {"speaker": "林夏", "text": "天穹里的人证都会出来的。", "emotion": "surprised", "audio": "/static/comic/voice/O_RC3ay_2.mp3", "dur": 2.92}], "T_RC3a": [{"speaker": "顾衡", "text": "为了和平，我愿意受审。", "emotion": "neutral", "audio": "/static/comic/voice/T_RC3a_0.mp3", "dur": 2.59}, {"speaker": "顾衡", "text": "媒体就站这边，镜头会证明我的诚意。", "emotion": "happy", "audio": "/static/comic/voice/T_RC3a_1.mp3", "dur": 4.36}, {"speaker": "顾衡", "text": "别眨眼，他们会替我处理的。", "emotion": "disgusted", "audio": "/static/comic/voice/T_RC3a_2.mp3", "dur": 3.06}], "O_RC3bx": [{"speaker": "林小雨", "text": "姐，他们说放我们回家了！", "emotion": "happy", "audio": "/static/comic/voice/O_RC3bx_0.mp3", "dur": 3.02}, {"speaker": "林夏", "text": "先走，别庆祝，保命最重要。", "emotion": "neutral", "audio": "/static/comic/voice/O_RC3bx_1.mp3", "dur": 3.1}, {"speaker": "林夏", "text": "星核交出去，等我们安全再谈未来。", "emotion": "sad", "audio": "/static/comic/voice/O_RC3bx_2.mp3", "dur": 4.93}], "O_RC3by": [{"speaker": "陈默", "text": "现在，全部上！", "emotion": "angry", "audio": "/static/comic/voice/O_RC3by_0.mp3", "dur": 1.51}, {"speaker": "林夏", "text": "为了小雨，也为了所有人，冲！", "emotion": "angry", "audio": "/static/comic/voice/O_RC3by_1.mp3", "dur": 2.95}, {"speaker": "陈默", "text": "别给对方留后路，收网！", "emotion": "neutral", "audio": "/static/comic/voice/O_RC3by_2.mp3", "dur": 2.16}], "T_RC3b": [{"speaker": "陈默", "text": "谁动了芯片？报名字！", "emotion": "angry", "audio": "/static/comic/voice/T_RC3b_0.mp3", "dur": 2.16}, {"speaker": "陈默", "text": "别藏了，亮出来交代清楚！", "emotion": "angry", "audio": "/static/comic/voice/T_RC3b_1.mp3", "dur": 2.2}, {"speaker": "林夏", "text": "芯片被夺，交换失败——大家退！", "emotion": "fearful", "audio": "/static/comic/voice/T_RC3b_2.mp3", "dur": 4.25}], "O_RA1by": [{"speaker": "陈默", "text": "放开她！别动！", "emotion": "angry", "audio": "/static/comic/voice/O_RA1by_0.mp3", "dur": 1.51}, {"speaker": "渡鸦", "text": "多余的热情。", "emotion": "neutral", "audio": "/static/comic/voice/O_RA1by_1.mp3", "dur": 1.48}, {"speaker": "林小雨", "text": "有人拉我走——林夏快跑！", "emotion": "fearful", "audio": "/static/comic/voice/O_RA1by_2.mp3", "dur": 2.84}, {"speaker": "林夏", "text": "星核碎了……证据没了。", "emotion": "sad", "audio": "/static/comic/voice/O_RA1by_3.mp3", "dur": 3.96}]}