    "speaker": "林夏",
    "text": "我们别无选择。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "陈默",
    "text": "街道被点燃了——太多人受伤！",
    "emotion": "angry",
    "speed": 1.1
   },
   {
    "speaker": "渡鸦",
    "text": "……",
    "emotion": "neutral",
    "speed": 0.9
   }
  ],
  "ambience": "rain_street",
  "sfx": "alarm",
  "sfx_at": 1
 },
 "O_RA2cx": {
  "lines": [
   {
    "speaker": "林小雨",
    "text": "姐姐，谢谢。",
    "emotion": "happy",
    "speed": 1.05
   },
   {
    "speaker": "林夏",
    "text": "保重，别参与报复。",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "陈默",
    "text": "快走！别回头！",
    "emotion": "urgent",
    "speed": 1.15
   }
  ],
  "ambience": "stairwell",
  "sfx": "footsteps_run",
  "sfx_at": 2
 },
 "O_RA2cy": {
  "lines": [
   {
    "speaker": "顾衡",
    "text": "别想逃。",
    "emotion": "disgusted",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "分散撤离，掩护我！",
    "emotion": "urgent",
    "speed": 1.15
   },
   {
    "speaker": "陈默",
    "text": "我堵住左侧，你跑右侧！",
    "emotion": "angry",
    "speed": 1.1
   }
  ],
  "ambience": "city_night",
  "sfx": "elevator_ding",
  "sfx_at": 0
 },
 "T_RA2c": {
  "lines": [
   {
    "speaker": "林小雨",
    "text": "姐！我被锁住了！",
    "emotion": "fearful",
    "speed": 1.15
   },
   {
    "speaker": "林夏",
    "text": "别放弃，等我。",
    "emotion": "determined",
    "speed": 0.95
   },
   {
    "speaker": "陈默",
    "text": "我冲上去，撑住她一刻钟！",
    "emotion": "angry",
    "speed": 1.1
   }
  ],
  "ambience": "alarm",
  "sfx": "sniper_bolt",
  "sfx_at": 0
 },
 "O_RA3a": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "价格不是问题。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "林小雨",
    "text": "我要一起走！",
    "emotion": "determined",
    "speed": 1.1
   },
   {
    "speaker": "陈默",
    "text": "别天真，地下也有规则。",
    "emotion": "disgusted",
    "speed": 0.95
   }
  ],
  "ambience": "rain_street",
  "sfx": "door_slam",
  "sfx_at": 2
 },
 "O_RA3b": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "我要跟董事长谈判。",
    "emotion": "determined",
    "speed": 1.0
   },
   {
    "speaker": "顾衡",
    "text": "你走得很远。",
    "emotion": "disgusted",
    "speed": 0.95
   },
   {
    "speaker": "陈默",
    "text": "别被他吃掉，林夏。",
    "emotion": "fearful",
    "speed": 1.05
   }
  ],
  "ambience": "boardroom",
  "sfx": "interior_hum",
  "sfx_at": 0
 },
 "O_RA3c": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "等到最合适的时机。",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "陈默",
    "text": "别让时间把我们吞掉。",
    "emotion": "sad",
    "speed": 0.9
   },
   {
    "speaker": "林小雨",
    "text": "我会守护芯片的，你放心。",
    "emotion": "happy",
    "speed": 1.05
   }
  ],
  "ambience": "rain_roof",
  "sfx": "chip_beep",
  "sfx_at": 2
 },
 "T_RA3": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "把它一分为二，成交一半。",
    "emotion": "neutral",
    "speed": 1.05
   },
   {
    "speaker": "顾衡",
    "text": "很好，半件足够威慑我。",
    "emotion": "happy",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "另一半已送进城市节点。",
    "emotion": "neutral",
    "speed": 1.1
   },
   {
    "speaker": "顾衡",
    "text": "你以为这能反我？",
    "emotion": "disgusted",
    "speed": 0.95
   }
  ],
  "ambience": "rain_roof",
  "sfx": "chip_beep",
  "sfx_at": 2
 },
 "O_RA3ax": {
  "lines": [
   {
    "speaker": "林小雨",
    "text": "我走了，别来找我麻烦。",
    "emotion": "determined",
    "speed": 1.1
   },
   {
    "speaker": "林夏",
    "text": "你远走，别回头——活着回来。",
    "emotion": "fearful",
    "speed": 1.05
   },
   {
    "speaker": "林小雨",
    "text": "答应我，我会消失一段时间。",
    "emotion": "happy",
    "speed": 1.0
   }
  ],
  "ambience": "dawn_wind",
  "sfx": "footsteps_run",
  "sfx_at": 2
 },
 "O_RA3ay": {
  "lines": [
   {
    "speaker": "顾衡",
    "text": "这买家很靠谱——都是我们人。",
    "emotion": "disgusted",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "你们别想得逞，星核还在我手上！",
    "emotion": "angry",
    "speed": 1.15
   },
   {
    "speaker": "顾衡",
    "text": "别急，交出芯片，你妹妹就安全。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "不！你们不会得逞！",
    "emotion": "angry",
    "speed": 1.15
   }
  ],
  "ambience": "rain_street",
  "sfx": "gunshot",
  "sfx_at": 2
 },
 "T_RA3a": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "没人能用它——我毁了。",
    "emotion": "angry",
    "speed": 1.05
   },
   {
    "speaker": "林小雨",
    "text": "你要烧掉证据？为什么！",
    "emotion": "surprised",
    "speed": 1.1
   },
   {
    "speaker": "林夏",
    "text": "宁可灰烬，也不让他们控制它。",
    "emotion": "determined",
    "speed": 1.0
   }
  ],
  "ambience": "rain_roof",
  "sfx": "explosion",
  "sfx_at": 2
 },
 "O_RA3bx": {
  "lines": [
   {
    "speaker": "顾衡",
    "text": "记住，你付出的代价很重。",
    "emotion": "disgusted",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "只要妹妹安全，其它都可以谈判。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "顾衡",
    "text": "很好，给你们一张免死牌。",
    "emotion": "happy",
    "speed": 1.0
   }
  ],
  "ambience": "boardroom",
  "sfx": "door_slam",
  "sfx_at": 2
 },
 "O_RA3by": {
  "lines": [
   {
    "speaker": "顾衡",
    "text": "听好了，你现在是穹顶的人。",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "我不会成为你们的帮凶！",
    "emotion": "angry",
    "speed": 1.1
   },
   {
    "speaker": "顾衡",
    "text": "封存星核，欢迎加入穹顶。",
    "emotion": "happy",
    "speed": 1.0
   }
  ],
  "ambience": "interior_hum",
  "sfx": "elevator_ding",
  "sfx_at": 2
 },
 "T_RA3b": {
  "lines": [
   {
    "speaker": "陈默",
    "text": "别信他的承诺，别上当。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "表面收编，暗里我们再卖一个给地下。",
    "emotion": "determined",
    "speed": 1.05
   },
   {
    "speaker": "陈默",
    "text": "危险，但这是我们唯一机会。",
    "emotion": "fearful",
    "speed": 1.0
   }
  ],
  "ambience": "stairwell",
  "sfx": "footsteps_run",
  "sfx_at": 0
 },
 "O_RA3cx": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "星核藏好，等时机揭露它。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "陈默",
    "text": "我陪你潜伏，等一个机会。",
    "emotion": "sad",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "生活会被推向对抗，但我们不放弃。",
    "emotion": "determined",
    "speed": 1.05
   }
  ],
  "ambience": "interior_hum",
  "sfx": "heartbeat",
  "sfx_at": 2
 },
 "O_RA3cy": {
  "lines": [
   {
    "speaker": "渡鸦",
    "text": "没有藏匿可言。",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "无人机来了——星核被炸碎了！",
    "emotion": "fearful",
    "speed": 1.1
   },
   {
    "speaker": "渡鸦",
    "text": "你妹妹已被定位。",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "我每走一步都可能死。",
    "emotion": "fearful",
    "speed": 1.05
   }
  ],
  "ambience": "rain_roof",
  "sfx": "explosion",
  "sfx_at": 1
 },
 "T_RA3c": {
  "lines": [
   {
    "speaker": "林小雨",
    "text": "姐，你疯了吗？把地点暴露？",
    "emotion": "angry",
    "speed": 1.05
   },
   {
    "speaker": "林夏",
    "text": "这是换你安全的唯一筹码。",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "林小雨",
    "text": "官方现在把我列为特别保护？",
    "emotion": "surprised",
    "speed": 1.1
   },
   {
    "speaker": "林夏",
    "text": "我赌一次——你要活着离开。",
    "emotion": "determined",
    "speed": 1.0
   }
  ],
  "ambience": "interior_hum",
  "sfx": "chip_beep",
  "sfx_at": 3
 },
 "O_RB1": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "拿好，别试探——别出声。",
    "emotion": "calm",
    "speed": 1.05
   },
   {
    "speaker": "渡鸦",
    "text": "你以为偷换能瞒过我？",
    "emotion": "disgusted",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "别动手，交易按规矩来。",
    "emotion": "neutral",
    "speed": 0.95
   }
  ],
  "ambience": "rain_roof",
  "sfx": "thunder",
  "sfx_at": 0
 },
 "O_RB2": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "糟糕……（故作惊慌）",
    "emotion": "surprised",
    "speed": 1.1
   },
   {
    "speaker": "渡鸦",
    "text": "别动！别想捡起来。",
    "emotion": "angry",
    "speed": 1.15
   },
   {
    "speaker": "林夏",
    "text": "我只是手滑，别冲动。",
    "emotion": "neutral",
    "speed": 1.0
   }
  ],
  "ambience": "rain_roof",
  "sfx": "footsteps_run",
  "sfx_at": 1
 },
 "O_RB3": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "全城都应该知道真相！",
    "emotion": "angry",
    "speed": 1.1
   },
   {
    "speaker": "顾衡",
    "text": "你以为这样就能胜利？别天真。",
    "emotion": "disgusted",
    "speed": 0.95
   },
   {
    "speaker": "林夏",
    "text": "我不求胜利，只求揭露。",
    "emotion": "determined",
    "speed": 1.05
   }
  ],
  "ambience": "city_night",
  "sfx": "crowd_gasp",
  "sfx_at": 2
 },
 "T_RB": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "或许这只是镜像，真芯片早被分散。",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "渡鸦",
    "text": "你在欺骗谁？自己吗？",
    "emotion": "disgusted",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "每一步都是赌——真假与代价。",
    "emotion": "sad",
    "speed": 0.9
   }
  ],
  "ambience": "interior_hum",
  "sfx": "chip_beep",
  "sfx_at": 0
 },
 "O_RB1a": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "把重点看这儿——看我的腕口。",
    "emotion": "calm",
    "speed": 1.05
   },
   {
    "speaker": "渡鸦",
    "text": "视线短暂偏移……",
    "emotion": "surprised",
    "speed": 1.1
   },
   {
    "speaker": "林夏",
    "text": "别转头，别多看其他东西。",
    "emotion": "neutral",
    "speed": 1.0
   }
  ],
  "ambience": "rain_roof",
  "sfx": "chip_beep",
  "sfx_at": 0
 },
 "O_RB1b": {
  "lines": [
   {
    "speaker": "渡鸦",
    "text": "放手让我看清楚它。",
    "emotion": "angry",
    "speed": 1.1
   },
   {
    "speaker": "林夏",
    "text": "你只看这一样，不许摸别的。",
    "emotion": "calm",
    "speed": 0.95
   },
   {
    "speaker": "渡鸦",
    "text": "好，我只看这一样，你别骗我。",
    "emotion": "neutral",
    "speed": 1.0
   }
  ],
  "ambience": "rain_roof",
  "sfx": "footsteps_run",
  "sfx_at": 2
 },
 "T_RB1": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "你们要真相？现在给你们。",
    "emotion": "angry",
    "speed": 1.05
   },
   {
    "speaker": "渡鸦",
    "text": "他妈的——怎么可能？",
    "emotion": "surprised",
    "speed": 1.1
   },
   {
    "speaker": "陈默",
    "text": "别开枪——别再动！",
    "emotion": "fearful",
    "speed": 1.1
   }
  ],
  "ambience": "rain_roof",
  "sfx": "glass_break",
  "sfx_at": 1
 },
 "O_RB1ax": {
  "lines": [
   {
    "speaker": "陈默",
    "text": "快走，巷子里有雾。",
    "emotion": "neutral",
    "speed": 1.05
   },
   {
    "speaker": "林夏",
    "text": "小雨要安全——明白？",
    "emotion": "angry",
    "speed": 1.1
   },
   {
    "speaker": "陈默",
    "text": "我挡着，你跑！",
    "emotion": "neutral",
    "speed": 1.08
   }
  ],
  "ambience": "rain_street",
  "sfx": "footsteps_run",
  "sfx_at": 2
 },
 "O_RB1ay": {
  "lines": [
   {
    "speaker": "渡鸦",
    "text": "不可能……那枪！",
    "emotion": "surprised",
    "speed": 1.12
   },
   {
    "speaker": "林夏",
    "text": "别躺下！撑住！",
    "emotion": "angry",
    "speed": 1.15
   },
   {
    "speaker": "陈默",
    "text": "你先活着——我来挡！",
    "emotion": "sad",
    "speed": 1.05
   }
  ],
  "ambience": "rain_roof",
  "sfx": "sniper_bolt",
  "sfx_at": 1
 },
 "T_RB1a": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "够了，别再牺牲了！",
    "emotion": "angry",
    "speed": 1.0
   },
   {
    "speaker": "渡鸦",
    "text": "你要逃？",
    "emotion": "neutral",
    "speed": 0.95
   },
   {
    "speaker": "陈默",
    "text": "上车！快！",
    "emotion": "fearful",
    "speed": 1.1
   }
  ],
  "ambience": "city_night",
  "sfx": "door_slam",
  "sfx_at": 2
 },
 "O_RB1bx": {
  "lines": [
   {
    "speaker": "渡鸦",
    "text": "停下——这东西不能放！",
    "emotion": "angry",
    "speed": 1.08
   },
   {
    "speaker": "顾衡",
    "text": "以为这样能翻盘？别天真。",
    "emotion": "disgusted",
    "speed": 0.9
   },
   {
    "speaker": "林小雨",
    "text": "真相已经出来了！",
    "emotion": "angry",
    "speed": 1.12
   }
  ],
  "ambience": "boardroom",
  "sfx": "chip_beep",
  "sfx_at": 1
 },
 "O_RB1by": {
  "lines": [
   {
    "speaker": "渡鸦",
    "text": "把那段日志给我！",
    "emotion": "neutral",
    "speed": 1.0
   },
   {
    "speaker": "林夏",
    "text": "你欠我时间，不欠别的。",
    "emotion": "angry",
    "speed": 0.98
   },
   {
    "speaker": "林小雨",
    "text": "离开，我走了！",
    "emotion": "surprised",
    "speed": 1.1
   }
  ],
  "ambience": "rain_roof",
  "sfx": "heartbeat",
  "sfx_at": 2
 },
 "T_RB1b": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "带她走，求你了。",
    "emotion": "sad",
    "speed": 0.9
   },
   {
    "speaker": "渡鸦",
    "text": "你删了关键段？",
    "emotion": "disgusted",
    "speed": 1.05
   },
   {
    "speaker": "林夏",
    "text": "换她的自由——换我一辈子沉默。",
    "emotion": "sad",
    "speed": 0.88
   }
  ],
  "ambience": "rain_roof",
  "sfx": "none",
  "sfx_at": 0
 },
 "O_RB2a": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "现在！雾幕启动！",
    "emotion": "angry",
    "speed": 1.12
   },
   {
    "speaker": "陈默",
    "text": "冲！别给他们喘息！",
    "emotion": "angry",
    "speed": 1.15
   },
   {
    "speaker": "渡鸦",
    "text": "这里视线被切断了！",
    "emotion": "surprised",
    "speed": 1.1
   }
  ],
  "ambience": "alarm",
  "sfx": "thunder",
  "sfx_at": 0
 },
 "O_RB2b": {
  "lines": [
   {
    "speaker": "林夏",
    "text": "带走我，放了小雨。",
    "emotion": "calm",
    "speed": 0.95
   },
   {
    "speaker": "渡鸦",
    "text": "你真敢赌命。",
    "emotion": "neutral",
    "speed": 1.05
   },
   {
    "speaker": "林夏",
    "text": "赌她能活着离开吧。",
    "emotion": "fearful",
    "speed": 1.05
   }
  ],
  "ambience": "rain_roof",
  "sfx": "rain_roof",
  "sfx_at": 0
 },
 "T_RB2": {
